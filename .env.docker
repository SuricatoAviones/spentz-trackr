# Copia este archivo a .env y ajusta los valores.
# APP_PORT: puerto público donde se sirve la app (http://localhost:8080)
#
# NO hace falta APP_KEY: se genera y persiste sola en storage/app.key
# (volumen spent_storage) en el primer arranque. Las migraciones también corren
# solas en cada arranque — solo ajusta DB_PASSWORD y ADMIN_*.
#
# El administrador NO se crea solo: tras el primer `docker compose up`, ejecuta
#   docker compose exec app php artisan admin:create
# una única vez (lee ADMIN_NAME / ADMIN_EMAIL / ADMIN_PASSWORD de aquí).

APP_NAME=Spentz Trackr
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080
APP_LOCALE=es

# --- CORS: orígenes permitidos (separados por coma). Vacío desactiva CORS. ---
CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- Registro de usuarios ---
# Ponlo en false si la instancia es privada: cierra a la vez el formulario web
# y POST /api/v1/auth/register.
REGISTRATION_ENABLED=true

# --- API REST ---
# Valor inicial. Un admin puede cambiarlo desde el panel (Sistema > API REST)
# y esa preferencia manda sobre esta variable.
API_ENABLED=true

# --- Sesiones seguras (requiere HTTPS). Activa el seguro cuando uses HTTPS. ---
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false

# --- Proxy de confianza ---
# SOLO la red del proxy que tengas delante (Traefik/nginx). Vacío = no se confía
# en ningún X-Forwarded-*, que es lo correcto si la app se expone directa.
# NO pongas '*': haría que cualquier cliente pudiera falsificar su IP (saltándose
# el límite de intentos de login) y el host de los enlaces de recuperación.
# La red por defecto de docker compose cae en 172.16.0.0/12.
TRUSTED_PROXIES=172.16.0.0/12

# --- MySQL (docker-compose.yml) ---
# Sin valores por defecto a propósito: ponlos tú, largos y aleatorios.
DB_DATABASE=spenttrackr
DB_USERNAME=spenttrackr
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3307

# --- PostgreSQL (docker-compose.pgsql.yml) ---
PGSQL_PORT=5433

ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
# Déjalo vacío y `admin:create` genera una aleatoria y la imprime una sola vez.
# Mínimo 12 caracteres con mayúsculas, minúsculas, número y símbolo.
ADMIN_PASSWORD=

# --- Documentos legales (/terminos y /privacidad) ---
# Quien opera la instancia es el responsable del tratamiento de datos.
LEGAL_OPERATOR=
LEGAL_CONTACT_EMAIL=
LEGAL_JURISDICTION=
LEGAL_EFFECTIVE_DATE=2026-09-13
